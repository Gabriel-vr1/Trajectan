# Defaults run entirely locally. Never put credentials in frontend variables.
DATABASE_URL=sqlite:///trajectan.db
# Optional; requires approved, existing cloud resources and runtime identity.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/trajectan?sslmode=require
# FOUNDRY_PROJECT_ENDPOINT=https://RESOURCE.services.ai.azure.com/api/projects/agentgate
# FOUNDRY_MODEL=gpt-4.1-mini
# SERVICE_BUS_NAMESPACE=NAMESPACE.servicebus.windows.net
# SERVICE_BUS_QUEUE=investigations

# Cloud-environment aliases are supported (values remain server-side):
# FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
# TRAJECTAN_FOUNDRY_KEY must be bound through runtime secret settings, never pasted here.
